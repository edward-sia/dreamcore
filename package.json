{
  "name": "hiraeth",
  "private": true,
  "version": "0.1.0",
  "description": "HIRAETH — a first-person dreamcore puzzle game in ten rooms",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edward-sia/dreamcore.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "shot": "node tools/screenshot.mjs",
    "playtest": "node tools/playtest.mjs",
    "test:api": "node tools/leaderboard-test.mjs",
    "test:touch": "node tools/touchtest.mjs",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:review": "tsx tools/review-ui.ts && tsx tools/review-flow.ts",
    "test:platform": "tsx tools/review-platform.ts",
    "review:shots": "tsx tools/review-levels.ts",
    "review:sheets": "tsx tools/review-sheets.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "tsx": "^4.23.13",
    "vite": "^5.4.21"
  }
}
